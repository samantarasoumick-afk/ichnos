# Copy this file to .env (same folder as docker-compose.yml) before
# running `docker compose up`. This file is gitignored - never commit
# the real one.

# --- Postgres ---
POSTGRES_USER=ichnos
POSTGRES_PASSWORD=changeme-pick-a-real-password
POSTGRES_DB=ichnos

# --- Auth ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=changeme-generate-a-real-random-secret

# --- Credential encryption (DataSource.connection_config at rest) ---
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this up somewhere safe - losing it makes every stored data
# source credential unreadable, and rotating it requires re-encrypting
# existing rows.
ENCRYPTION_KEY=changeme-generate-a-real-fernet-key

# --- CORS ---
# The public URL testers will use to reach the app (not the marketing
# site). If you're using a Cloudflare Tunnel per docs/SELF_HOSTING.md,
# this is the app's tunnel hostname, e.g. https://app.ichnos.yourdomain.com.
# Comma-separate multiple origins.
CORS_ALLOWED_ORIGINS=http://app.localhost

# --- Frontend URL (used to build links in emails, e.g. magic-link login) ---
FRONTEND_URL=http://app.localhost

# --- Email (magic-link login / password recovery) ---
# Leave SMTP_HOST unset for local solo use - emails (including login
# links) get logged to the backend's own console/logs instead of
# actually sending, which is enough while it's just you. Set real
# values here before opening the instance up to outside testers, or
# nobody but you will ever receive a login link.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Ichnos <no-reply@yourdomain.com>

# --- Ask assistant (LLM-backed open-ended Q&A) ---
# Leave ANTHROPIC_API_KEY unset for local solo use - the Ask page still
# works, but only answers the fixed set of questions it can match by
# keyword (ownership, PII, lineage, governance, contracts) plus a
# keyword-search fallback. Set a real key to let it answer genuinely
# open-ended and multi-turn questions, grounded in your actual catalog
# data (get a key at https://console.anthropic.com).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Optional ---
# Seeds a demo org with sample data on first boot. Leave false once
# real users are on the instance.
DEMO_SEED=false
