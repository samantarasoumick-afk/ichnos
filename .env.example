# Copy this file to .env (same folder as docker-compose.yml) before
# running `docker compose up`. This file is gitignored - never commit
# the real one.

# --- Postgres ---
POSTGRES_USER=datafe
POSTGRES_PASSWORD=changeme-pick-a-real-password
POSTGRES_DB=datafe

# --- Auth ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=changeme-generate-a-real-random-secret

# --- Credential encryption (DataSource.connection_config at rest) ---
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this up somewhere safe - losing it makes every stored data
# source credential unreadable, and rotating it requires re-encrypting
# existing rows.
ENCRYPTION_KEY=changeme-generate-a-real-fernet-key

# --- CORS ---
# The public URL testers will use to reach the app (not the marketing
# site). If you're using a Cloudflare Tunnel per docs/SELF_HOSTING.md,
# this is the app's tunnel hostname, e.g. https://app.datafetech.com.
# Comma-separate multiple origins. Include the marketing site's own
# origin too (e.g. https://datafetech.com, no "app." prefix) -
# its visitor-tracking snippet calls the backend cross-origin.
CORS_ALLOWED_ORIGINS=http://app.localhost,http://localhost

# --- Frontend URL (used to build links in emails, e.g. magic-link login) ---
FRONTEND_URL=http://app.localhost

# --- Email (magic-link login / password recovery) ---
# Leave SMTP_HOST unset for local solo use - emails (including login
# links) get logged to the backend's own console/logs instead of
# actually sending, which is enough while it's just you. Set real
# values here before opening the instance up to outside testers, or
# nobody but you will ever receive a login link.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=DataFe <no-reply@datafetech.com>

# --- Ask assistant (LLM-backed open-ended Q&A) ---
# Leave ANTHROPIC_API_KEY unset for local solo use - the Ask page still
# works, but only answers the fixed set of questions it can match by
# keyword (ownership, PII, lineage, governance, contracts) plus a
# keyword-search fallback. Set a real key to let it answer genuinely
# open-ended and multi-turn questions, grounded in your actual catalog
# data (get a key at https://console.anthropic.com).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Sign in with GitHub (OAuth) ---
# Leave both unset to disable "Continue with GitHub" on the login page
# - it still shows, but returns a clear error instead of a broken
# redirect. Register a free OAuth App at
# https://github.com/settings/developers ("New OAuth App"). Set its
# "Authorization callback URL" to
# <FRONTEND_URL above>/login/github/callback - e.g.
# http://app.localhost/login/github/callback for this compose setup,
# or your real tunnel/domain once you have one. No credit card or
# billing info required, unlike Google's OAuth consent screen.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Stripe billing (self-serve Team/Business checkout) ---
# Leave STRIPE_SECRET_KEY unset to run without self-serve billing -
# every org just stays on its current plan/status, set manually via
# the platform admin API (PATCH /api/platform/organizations/{id}/plan).
# Set these to turn on real "Upgrade" buttons in the app. Get the
# secret key and create a webhook endpoint (pointed at
# <your app URL>/api/billing/webhook, events: checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted) at
# https://dashboard.stripe.com. Enterprise/custom is deliberately not
# here - it's always a manual platform-admin override, never self-serve.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs (dashboard.stripe.com/prices) for each self-serve plan x
# billing-cycle combination.
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# --- Optional ---
# Seeds a demo org with sample data on first boot. Leave false once
# real users are on the instance.
DEMO_SEED=false
