# Copy this file to backend/.env (or export these in your shell /
# deploy environment) before running the app or Alembic.

# --- Database ---
DATABASE_URL=postgresql://admin:admin@localhost:5432/metadata_db

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=changeme-generate-a-real-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Credential encryption (DataSource.connection_config at rest) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every stored data-source credential unreadable.
# Rotating it requires re-encrypting existing rows.
ENCRYPTION_KEY=changeme-generate-a-real-fernet-key

# --- CORS ---
# Comma-separated list of exact origins allowed to call the API with
# credentials. Never use "*" here - it defeats allow_credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Ask assistant (LLM-backed open-ended Q&A) ---
# Leave unset to keep the Ask page on its deterministic keyword-matched
# answers + search fallback. Set a real key to enable genuinely
# open-ended, multi-turn answers grounded in your catalog data.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Semantic search (catalog search bar + Ask assistant retrieval) ---
# Leave unset to keep search on the free, local TF-IDF ranking
# (catalog_search_service.py) - still a real improvement over exact
# substring matching, just not neural embeddings. Set a real key
# (from https://dashboard.voyageai.com, Anthropic's recommended
# embeddings partner - Anthropic itself doesn't offer an embeddings
# endpoint) to rank search/retrieval by actual semantic similarity
# instead of term overlap. Embeddings are computed once per entity and
# cached (see the entity_embeddings table), not on every search.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite

# --- Sign in with GitHub (OAuth) ---
# Leave both unset to disable "Continue with GitHub" - the button on
# the login page still shows, but clicking it returns a 503 rather
# than a broken redirect. Register a free OAuth App at
# https://github.com/settings/developers ("New OAuth App"); set its
# "Authorization callback URL" to
# <FRONTEND_URL>/login/github/callback (see docs/SELF_HOSTING.md).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Stripe billing (self-serve Team/Business checkout) ---
# Leave STRIPE_SECRET_KEY unset to run without self-serve billing -
# plan/status then only change via a manual platform-admin override
# (PATCH /api/platform/organizations/{id}/plan). Webhook endpoint:
# <FRONTEND_URL>/api/billing/webhook, events: checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# --- Dev-only convenience flags (leave "false" anywhere migrations
# are the source of truth for schema, i.e. staging/production) ---
AUTO_CREATE_SCHEMA=false
DEMO_SEED=false
